{
  "name": "obsidian-activity-timeline",
  "version": "0.1.1",
  "description": "A timeline of everything that happens in your vault: notes created and edited, tasks completed and dropped, captures. Built from live events and git history.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "timeline",
    "activity",
    "history"
  ],
  "license": "0BSD",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "diff": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "lucide-static": "^1.52.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.0.0"
  },
  "author": "Pavel Fedorov"
}
